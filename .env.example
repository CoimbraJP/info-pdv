# Copie para .env e preencha com suas credenciais.
# No Vercel, configure estas variáveis em Project Settings > Environment Variables.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU_CLUSTER.mongodb.net/infopdv?retryWrites=true&w=majority
MONGODB_DB=infopdv

# Token de autenticação da API /api/sync (obrigatório; gere um valor longo e
# aleatório, ex.: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Os DOIS valores devem ser idênticos e configurados também na Vercel.
SYNC_TOKEN=TROQUE_POR_UM_TOKEN_LONGO_ALEATORIO
VITE_SYNC_TOKEN=TROQUE_POR_UM_TOKEN_LONGO_ALEATORIO

# (Opcional) Origem liberada para CORS — só se o front rodar em domínio/porta
# diferente da API.
# ALLOWED_ORIGIN=http://localhost:5173

# Token de LEITURA para integração com o CRM (GET /api/crm-sync).
# Gere um valor próprio — não reutilize o SYNC_TOKEN.
CRM_READ_TOKEN=TROQUE_POR_OUTRO_TOKEN_LONGO_ALEATORIO

# (Opcional) Base da API no front. Em produção na Vercel deixe vazio (mesmo domínio).
# VITE_API_URL=
